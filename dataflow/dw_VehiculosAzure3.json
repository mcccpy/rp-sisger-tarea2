{
	"name": "dw_VehiculosAzure3",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_VehiculosAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_VehiculosAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn3 derive(VigenciaDesde = replace(VigenciaDesde,'/','-'),",
				"          VigenciaHasta = replace(VigenciaHasta,'/','-'),",
				"          VehiculoId = 'V-' + right('000' + regexReplace(VehiculoId,'[^0-9]',''), 3),",
				"          Placa = 'ABC-' + right('000' + regexReplace(Placa,'[^0-9]',''), 3),",
				"          Estado = upper(Estado)) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = toInteger(AnioFuente),",
				"          CapacidadEfectiva = toInteger(CapacidadEfectiva),",
				"          VigenciaDesde = iif(\r",
				"    length(split(VigenciaDesde,'-')[1]) == 4,\r",
				"    toDate(VigenciaDesde,'yyyy-MM-dd'),\r",
				"    toDate(VigenciaDesde,'dd-MM-yyyy')\r",
				"),",
				"          VigenciaHasta = iif(\r",
				"    length(split(VigenciaHasta,'-')[1]) == 4,\r",
				"    toDate(VigenciaHasta,'yyyy-MM-dd'),\r",
				"    toDate(VigenciaHasta,'dd-MM-yyyy')\r",
				")) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(VehiculoId),",
				"     each(match(name!='VehiculoId'), $$ = first($$))) ~> aggregate1",
				"aggregate1 filter(Estado == 'ACTIVO') ~> filter1",
				"source1 derive(each(match(type == 'string'), $$ = trim($$))) ~> derivedColumn3",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}