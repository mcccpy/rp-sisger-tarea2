{
	"name": "IncidenteRutaAzure_br7",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "IncidenteRutaAzure_erp",
						"type": "DatasetReference"
					},
					"name": "sql"
				},
				{
					"dataset": {
						"referenceName": "incidentes_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "Incidentes_xlssx",
						"type": "DatasetReference"
					},
					"name": "xlsx23"
				},
				{
					"dataset": {
						"referenceName": "Incidentes_xlsx",
						"type": "DatasetReference"
					},
					"name": "xlsx22"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_IncidenteRutaAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "union1"
				},
				{
					"name": "union2"
				},
				{
					"name": "union3"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx23",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx22",
				"derivedColumn2, derivedColumn3 union(byName: true)~> union1",
				"derivedColumn4, union1 union(byName: true)~> union2",
				"sql, derivedColumn1 union(byName: true)~> union3",
				"union2 select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          EsPrincipal = severidad,",
				"          RutaHistoricaId = rutas_afectadas,",
				"          AnioFuente",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(EsPrincipal = case(\r",
				"    trim(upper(EsPrincipal))== 'BAJA' ,'False',\r",
				"    trim(upper(EsPrincipal))== 'MEDIA' ,'False',\r",
				"    trim(upper(EsPrincipal))== 'ALTA' ,'True',\r",
				"    trim(upper(EsPrincipal))== 'CRITICA' ,'True',\r",
				"    EsPrincipal\r",
				")) ~> derivedColumn1",
				"xlsx23 derive(AnioFuente = '2023') ~> derivedColumn2",
				"xlsx22 derive(AnioFuente = '2022') ~> derivedColumn3",
				"csv derive(AnioFuente = case(\r",
				"    instr(id_incidente,'IN-2021')>0,'2021',\r",
				"    '2020'\r",
				")) ~> derivedColumn4",
				"union3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          RutaHistoricaId,",
				"          EsPrincipal",
				"     )) ~> sink1"
			]
		}
	}
}