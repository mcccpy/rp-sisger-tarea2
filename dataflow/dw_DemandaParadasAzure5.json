{
	"name": "dw_DemandaParadasAzure5",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_DemandaParadasAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_DemandaParadasAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "window1"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn3 derive(RutaHistoricaId = case (\r",
				"    regexMatch(RutaHistoricaId, '^RH-[0-9]{2}-(S|N)$'),RutaHistoricaId,\r",
				"    'RH-'+right('00' + regexReplace(RutaHistoricaId,'[^0-9]',''), 2)\r",
				"),",
				"          Metodo = upper(Metodo)) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = toInteger(AnioFuente),",
				"          FechaServicio = case(\r",
				"    regexMatch(toString(FechaServicio), '^[0-9]+$'),\r",
				"    addDays(\r",
				"        toDate('1899-12-30'),\r",
				"        toInteger(FechaServicio)\r",
				"    ),\r",
				"\r",
				"    regexMatch(\r",
				"        toString(FechaServicio),\r",
				"        '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'\r",
				"    ),\r",
				"    toDate(\r",
				"        toString(FechaServicio),\r",
				"        'yyyy-MM-dd'\r",
				"    ),\r",
				"\r",
				"    regexMatch(\r",
				"        toString(FechaServicio),\r",
				"        '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$'\r",
				"    ),\r",
				"    toDate(\r",
				"        toString(FechaServicio),\r",
				"        'd/M/yyyy'\r",
				"    ),\r",
				"\r",
				"    toDate(FechaServicio)\r",
				"),",
				"          ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
				"          Descensos = toInteger(Descensos),",
				"          DemandaNoAtendida = toInteger(DemandaNoAtendida),",
				"          ParadaHistoricaId = iif (\r",
				"    regexMatch(ParadaHistoricaId, '^P[0-9]{3}.*'),\r",
				"    regexExtract(ParadaHistoricaId, '(P[0-9]+)', 1),\r",
				"    ParadaHistoricaId\r",
				")) ~> derivedColumn2",
				"source1 derive(each(match(type=='string'), $$ = trim($$))) ~> derivedColumn3",
				"aggregate1 window(over(AnioFuente),",
				"     asc(FechaServicio, true),",
				"     dt_new_id = rowNumber()) ~> window1",
				"window1 derive(DemandaId = iif (\r",
				"    isNull(DemandaId),'DM-'+toString(AnioFuente)+'-'+right('00000' + toString(dt_new_id), 5),DemandaId\r",
				")\r",
				") ~> derivedColumn4",
				"derivedColumn2 aggregate(groupBy(FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId),",
				"     each(match(\r",
				"name != 'FechaServicio'  && name != 'RutaHistoricaId' && name != 'ParadaHistoricaId'), $$ = first($$))) ~> aggregate1",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}