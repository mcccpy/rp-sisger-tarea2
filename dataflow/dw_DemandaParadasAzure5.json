{
	"name": "dw_DemandaParadasAzure5",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_DemandaParadasAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_DemandaParadasAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(FechaServicio = replace(trim(FechaServicio),'/','-'),",
				"          AnioFuente = trim(AnioFuente),",
				"          DemandaId = trim(DemandaId),",
				"          RutaHistoricaId = trim(RutaHistoricaId),",
				"          ParadaHistoricaId = trim(ParadaHistoricaId),",
				"          Franja = trim(Franja),",
				"          ValidacionesTarjeta = trim(ValidacionesTarjeta),",
				"          Descensos = trim(Descensos),",
				"          DemandaNoAtendida = trim(DemandaNoAtendida),",
				"          Metodo = trim(Metodo)) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = toInteger(AnioFuente),",
				"          FechaServicio = iif(\r",
				"    length(split(FechaServicio,'-')[1]) == 4,\r",
				"    toDate(FechaServicio,'yyyy-MM-dd'),\r",
				"    toDate(FechaServicio,'dd-MM-yyyy')\r",
				"),",
				"          ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
				"          Descensos = toInteger(Descensos),",
				"          DemandaNoAtendida = toInteger(DemandaNoAtendida)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}