{
	"name": "dw_DemandaParadasAzure5",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_DemandaParadasAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_DemandaParadasAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn3 derive(FechaServicio = replace(FechaServicio,'/','-'),",
				"          AnioFuente = ERROR_FUNCTION(''),",
				"          DemandaId = ERROR_FUNCTION(''),",
				"          RutaHistoricaId = case (\r",
				"    regexMatch(RutaHistoricaId, '^RH-[0-9]{2}-(S|N)$'),RutaHistoricaId,\r",
				"    regexMatch(RutaHistoricaId, '^RH-[0-9]{2}$'),RutaHistoricaId,\r",
				"    'RH-'+regexExtract(RutaHistoricaId, '([0-9]{2})', 1)\r",
				"),",
				"          ParadaHistoricaId = trim(ParadaHistoricaId),",
				"          Franja = ERROR_FUNCTION('__NEW_LINE_R____NEW_LINE_N__'),",
				"          ValidacionesTarjeta = ERROR_FUNCTION('__NEW_LINE_R____NEW_LINE_N__'),",
				"          Descensos = ERROR_FUNCTION('__NEW_LINE_R____NEW_LINE_N__'),",
				"          DemandaNoAtendida = ERROR_FUNCTION('__NEW_LINE_R____NEW_LINE_N__'),",
				"          Metodo = upper(Metodo)) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = toInteger(AnioFuente),",
				"          FechaServicio = iif(\r",
				"    length(split(FechaServicio,'-')[1]) == 4,\r",
				"    toDate(FechaServicio,'yyyy-MM-dd'),\r",
				"    toDate(FechaServicio,'dd-MM-yyyy')\r",
				"),",
				"          ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
				"          Descensos = toInteger(Descensos),",
				"          DemandaNoAtendida = toInteger(DemandaNoAtendida),",
				"          ParadaHistoricaId = iif (\r",
				"    regexMatch(ParadaHistoricaId, '^P[0-9]{3}.*'),\r",
				"    regexExtract(ParadaHistoricaId, '(P[0-9]+)', 1),\r",
				"    ParadaHistoricaId\r",
				")) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(DemandaId),",
				"     each(match(name!='DemandaId'), $$ = first($$))) ~> aggregate1",
				"source1 derive(each(match(type == 'string'), $$ = trim($$))) ~> derivedColumn3",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}