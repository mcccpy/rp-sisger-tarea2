{
	"name": "ParadasAzure_br2",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "paradas_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "Paradas_xlsx",
						"type": "DatasetReference"
					},
					"name": "xlsx22"
				},
				{
					"dataset": {
						"referenceName": "Paradas_xlssx",
						"type": "DatasetReference"
					},
					"name": "xlsx23"
				},
				{
					"dataset": {
						"referenceName": "ParadasAzure_erp",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_ParadasAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "union1"
				},
				{
					"name": "select2"
				},
				{
					"name": "union2"
				},
				{
					"name": "union3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx22",
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx23",
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"csv select(mapColumn(",
				"          nro_parada,",
				"          nombre_parada,",
				"          zona,",
				"          latitud,",
				"          longitud,",
				"          fecha_desde,",
				"          fecha_hasta,",
				"          estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, select2 union(byName: true)~> union1",
				"union2 select(mapColumn(",
				"          nro_parada,",
				"          nombre_parada,",
				"          zona,",
				"          latitud,",
				"          longitud,",
				"          fecha_desde,",
				"          fecha_hasta,",
				"          estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"xlsx22, xlsx23 union(byName: true)~> union2",
				"union1, sql union(byName: true)~> union3",
				"union3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}