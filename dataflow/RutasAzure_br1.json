{
	"name": "RutasAzure_br1",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "rutas_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "Rutas_xlsx",
						"type": "DatasetReference"
					},
					"name": "xlsx22"
				},
				{
					"dataset": {
						"referenceName": "Rutas_xlssx",
						"type": "DatasetReference"
					},
					"name": "xlsx23"
				},
				{
					"dataset": {
						"referenceName": "RutasAzure_erp",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx22",
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx23",
				"source(output(",
				"          AnioFuente as integer,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql"
			]
		}
	}
}