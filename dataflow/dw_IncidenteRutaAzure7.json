{
	"name": "dw_IncidenteRutaAzure7",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_IncidenteRutaAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_IncidenteRutaAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn3 derive(AnioFuente = toInteger(AnioFuente),",
				"          EsPrincipal = lower(EsPrincipal)=='true',",
				"          RutaHistoricaId = case (\r",
				"    regexMatch(RutaHistoricaId, '^RH-[0-9]{2}-(S|N)$'),RutaHistoricaId,\r",
				"    regexMatch(RutaHistoricaId, '^RH-[0-9]{2}$'),RutaHistoricaId,\r",
				"    'RH-'+regexExtract(RutaHistoricaId, '([0-9]{2})', 1)\r",
				")) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(IncidenteId,",
				"          RutaHistoricaId),",
				"     each(match(!(name=='IncidenteId'||name=='RutaHistoricaId')), $$ = first($$))) ~> aggregate1",
				"source1 derive(each(match(type == 'string'), $$ = trim($$))) ~> derivedColumn3",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}