{
	"name": "dw_IncidentesAzure6",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_IncidentesAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_IncidentesAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(FechaHoraInicio = trim(FechaHoraInicio),",
				"          FechaHoraFin = trim(FechaHoraFin),",
				"          FechaHoraRegistro = trim(FechaHoraRegistro),",
				"          AnioFuente = trim(AnioFuente),",
				"          IncidenteId = trim(IncidenteId),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          VehiculoId = \r",
				"iif(\r",
				"    !isNull(VehiculoId),'V-' + right('000' + regexReplace(trim(VehiculoId),'[^0-9]',''), 3),VehiculoId\r",
				"),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = toInteger(AnioFuente),",
				"          FechaHoraInicio = case(\r",
				"    regexMatch(FechaHoraInicio, '^[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraInicio, 'dd/MM/yyyy HH:mm'),\r",
				"\r",
				"    regexMatch(FechaHoraInicio, '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraInicio, 'yyyy-MM-dd HH:mm'),\r",
				"\r",
				"    regexMatch(FechaHoraInicio, '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),\r",
				"    toTimestamp(FechaHoraInicio + ' 00:00', 'dd/MM/yyyy HH:mm'),\r",
				"\r",
				"    regexMatch(FechaHoraInicio, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraInicio + ' 00:00', 'yyyy-MM-dd HH:mm'),\r",
				"    \r",
				"    regexMatch(\r",
				"        FechaHoraInicio,\r",
				"        '^[0-9]{4}-[0-9]{2}-[0-9]{2} 1899-12-31T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\.[0-9]{3}Z$'\r",
				"    ),\r",
				"    toTimestamp(\r",
				"        substring(FechaHoraInicio,1,10) + ' ' +\r",
				"        substring(FechaHoraInicio,22,8),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    toTimestamp(FechaHoraInicio)\r",
				"\r",
				"),",
				"          FechaHoraFin = case(\r",
				"    regexMatch(FechaHoraFin, '^[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraFin, 'dd/MM/yyyy HH:mm'),\r",
				"\r",
				"    regexMatch(FechaHoraFin, '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraFin, 'yyyy-MM-dd HH:mm'),\r",
				"\r",
				"    regexMatch(FechaHoraFin, '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),\r",
				"    toTimestamp(FechaHoraFin + ' 00:00', 'dd/MM/yyyy HH:mm'),\r",
				"\r",
				"    regexMatch(FechaHoraFin, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraFin + ' 00:00', 'yyyy-MM-dd HH:mm'),\r",
				"    \r",
				"    regexMatch(\r",
				"        FechaHoraFin,\r",
				"        '^[0-9]{4}-[0-9]{2}-[0-9]{2} 1899-12-31T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\.[0-9]{3}Z$'\r",
				"    ),\r",
				"    toTimestamp(\r",
				"        substring(FechaHoraFin,1,10) + ' ' +\r",
				"        substring(FechaHoraFin,22,8),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    toTimestamp(FechaHoraFin)\r",
				"),",
				"          FechaHoraRegistro = case(\r",
				"    regexMatch(FechaHoraRegistro, '^[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraRegistro, 'dd/MM/yyyy HH:mm'),\r",
				"\r",
				"    regexMatch(FechaHoraRegistro, '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraRegistro, 'yyyy-MM-dd HH:mm'),\r",
				"\r",
				"    regexMatch(FechaHoraRegistro, '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),\r",
				"    toTimestamp(FechaHoraRegistro + ' 00:00', 'dd/MM/yyyy HH:mm'),\r",
				"\r",
				"    regexMatch(FechaHoraRegistro, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraRegistro + ' 00:00', 'yyyy-MM-dd HH:mm'),\r",
				"    \r",
				"    regexMatch(\r",
				"        FechaHoraRegistro,\r",
				"        '^[0-9]{4}-[0-9]{2}-[0-9]{2} 1899-12-31T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\.[0-9]{3}Z$'\r",
				"    ),\r",
				"    toTimestamp(\r",
				"        substring(FechaHoraRegistro,1,10) + ' ' +\r",
				"        substring(FechaHoraRegistro,22,8),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    toTimestamp(FechaHoraRegistro)\r",
				")) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(IncidenteId),",
				"     each(match(name!='IncidenteId'), $$ = first($$))) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}