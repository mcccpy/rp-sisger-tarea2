{
	"name": "dw_IncidentesAzure6",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_IncidentesAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_IncidentesAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn3 derive(TipoIncidente = upper(TipoIncidente),",
				"          Severidad = upper(Severidad),",
				"          VehiculoId = iif(\r",
				"    !isNull(VehiculoId),'V-' + right('000' + regexReplace(VehiculoId,'[^0-9]',''), 3),VehiculoId\r",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = toInteger(AnioFuente),",
				"          FechaHoraInicio = case(\r",
				"\r",
				"    /* Fecha Excel serial */\r",
				"    regexMatch(toString(FechaHoraInicio),'^[0-9]+$'),\r",
				"    toTimestamp(\r",
				"        toString(\r",
				"            addDays(toDate('1899-12-30'), toInteger(FechaHoraInicio))\r",
				"        ) + ' 00:00:00',\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* yyyy-MM-dd HH:mm */\r",
				"    regexMatch(FechaHoraInicio,'^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraInicio,'yyyy-MM-dd HH:mm'),\r",
				"\r",
				"    /* dd/MM/yyyy HH:mm */\r",
				"    regexMatch(FechaHoraInicio,'^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraInicio,'d/M/yyyy HH:mm'),\r",
				"\r",
				"    /* yyyy-MM-dd */\r",
				"    regexMatch(FechaHoraInicio,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toTimestamp(\r",
				"        FechaHoraInicio + ' 00:00:00',\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* dd/MM/yyyy */\r",
				"    regexMatch(FechaHoraInicio,'^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$'),\r",
				"    toTimestamp(\r",
				"        FechaHoraInicio + ' 00:00:00',\r",
				"        'd/M/yyyy HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* Hora sola HH:mm */\r",
				"    regexMatch(FechaHoraInicio,'^[0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(\r",
				"        toString(FechaHoraInicio)\r",
				"        + ' ' +\r",
				"        FechaHoraInicio\r",
				"        + ':00',\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* Hora Excel */\r",
				"    regexMatch(\r",
				"        FechaHoraInicio,\r",
				"        '^1899-12-31T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$'\r",
				"    ),\r",
				"    toTimestamp(\r",
				"        toString(FechaHoraInicio)\r",
				"        + ' ' +\r",
				"        substring(FechaHoraInicio,12,8),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* No reconocido */\r",
				"    toTimestamp(\r",
				"        FechaHoraInicio\r",
				"    )\r",
				"),",
				"          FechaHoraFin = case(\r",
				"\r",
				"    /* Fecha Excel serial */\r",
				"    regexMatch(toString(FechaHoraFin),'^[0-9]+$'),\r",
				"    toTimestamp(\r",
				"        toString(\r",
				"            addDays(toDate('1899-12-30'), toInteger(FechaHoraFin))\r",
				"        ) + ' 00:00:00',\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* yyyy-MM-dd HH:mm */\r",
				"    regexMatch(FechaHoraFin,'^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraFin,'yyyy-MM-dd HH:mm'),\r",
				"\r",
				"    /* dd/MM/yyyy HH:mm */\r",
				"    regexMatch(FechaHoraFin,'^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraFin,'d/M/yyyy HH:mm'),\r",
				"\r",
				"    /* yyyy-MM-dd */\r",
				"    regexMatch(FechaHoraFin,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toTimestamp(\r",
				"        FechaHoraFin + ' 00:00:00',\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* dd/MM/yyyy */\r",
				"    regexMatch(FechaHoraFin,'^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$'),\r",
				"    toTimestamp(\r",
				"        FechaHoraFin + ' 00:00:00',\r",
				"        'd/M/yyyy HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* Hora sola HH:mm */\r",
				"    regexMatch(FechaHoraFin,'^[0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(\r",
				"        toString(FechaHoraInicio)\r",
				"        + ' ' +\r",
				"        FechaHoraFin\r",
				"        + ':00',\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* Hora Excel */\r",
				"    regexMatch(\r",
				"        FechaHoraFin,\r",
				"        '^1899-12-31T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$'\r",
				"    ),\r",
				"    toTimestamp(\r",
				"        toString(FechaHoraInicio)\r",
				"        + ' ' +\r",
				"        substring(FechaHoraFin,12,8),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* No reconocido */\r",
				"    toTimestamp(\r",
				"        FechaHoraInicio\r",
				"    )\r",
				"),",
				"          FechaHoraRegistro = \r",
				"\r",
				"case(\r",
				"\r",
				"    /* Fecha Excel serial */\r",
				"    regexMatch(toString(FechaHoraRegistro),'^[0-9]+$'),\r",
				"    toTimestamp(\r",
				"        toString(\r",
				"            addDays(toDate('1899-12-30'), toInteger(FechaHoraRegistro))\r",
				"        ) + ' 00:00:00',\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* yyyy-MM-dd HH:mm */\r",
				"    regexMatch(FechaHoraRegistro,'^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraRegistro,'yyyy-MM-dd HH:mm'),\r",
				"\r",
				"    /* dd/MM/yyyy HH:mm */\r",
				"    regexMatch(FechaHoraRegistro,'^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(FechaHoraRegistro,'d/M/yyyy HH:mm'),\r",
				"\r",
				"    /* yyyy-MM-dd */\r",
				"    regexMatch(FechaHoraRegistro,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toTimestamp(\r",
				"        FechaHoraRegistro + ' 00:00:00',\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* dd/MM/yyyy */\r",
				"    regexMatch(FechaHoraRegistro,'^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$'),\r",
				"    toTimestamp(\r",
				"        FechaHoraRegistro + ' 00:00:00',\r",
				"        'd/M/yyyy HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* Hora sola HH:mm */\r",
				"    regexMatch(FechaHoraRegistro,'^[0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(\r",
				"        toString(FechaHoraInicio)\r",
				"        + ' ' +\r",
				"        FechaHoraRegistro\r",
				"        + ':00',\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* Hora Excel */\r",
				"    regexMatch(\r",
				"        FechaHoraRegistro,\r",
				"        '^1899-12-31T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$'\r",
				"    ),\r",
				"    toTimestamp(\r",
				"        toString(FechaHoraInicio)\r",
				"        + ' ' +\r",
				"        substring(FechaHoraRegistro,12,8),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    /* No reconocido */\r",
				"    toTimestamp(\r",
				"        FechaHoraRegistro\r",
				"    )\r",
				")) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(IncidenteId),",
				"     each(match(name!='IncidenteId'), $$ = first($$))) ~> aggregate1",
				"source1 derive(each(match(type=='string'), $$ = trim($$))) ~> derivedColumn3",
				"aggregate1 derive(each(match(type == 'timestamp'), $$ = iif(\r",
				"    isNull($$),toTimestamp('9999-12-31 00:00:00'),$$\r",
				"))) ~> derivedColumn4",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}