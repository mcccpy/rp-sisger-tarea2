{
	"name": "IncidentesAzure_br6",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "incidentes_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "Incidentes_xlsx",
						"type": "DatasetReference"
					},
					"name": "xlsx22"
				},
				{
					"dataset": {
						"referenceName": "Incidentes_xlssx",
						"type": "DatasetReference"
					},
					"name": "xlsx223"
				},
				{
					"dataset": {
						"referenceName": "IncidentesAzure_erp",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx22",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx223",
				"source(output(",
				"          AnioFuente as integer,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql"
			]
		}
	}
}