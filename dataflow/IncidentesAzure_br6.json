{
	"name": "IncidentesAzure_br6",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "incidentes_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "Incidentes_xlsx",
						"type": "DatasetReference"
					},
					"name": "xlsx22"
				},
				{
					"dataset": {
						"referenceName": "Incidentes_xlssx",
						"type": "DatasetReference"
					},
					"name": "xlsx223"
				},
				{
					"dataset": {
						"referenceName": "IncidentesAzure_erp",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_IncidentesAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "union1"
				},
				{
					"name": "select2"
				},
				{
					"name": "union2"
				},
				{
					"name": "union3"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx22",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx223",
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"csv select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          FechaHoraInicio = fecha_inicio,",
				"          hin = hora_inicio,",
				"          FechaHoraFin = fecha_fin,",
				"          hfi = hora_fin,",
				"          FechaHoraRegistro = fecha_registro,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, select2 union(byName: true)~> union1",
				"union2 select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          FechaHoraInicio = fecha_inicio,",
				"          hin = hora_inicio,",
				"          FechaHoraFin = fecha_fin,",
				"          hfi = hora_fin,",
				"          FechaHoraRegistro = fecha_registro,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"xlsx22, xlsx223 union(byName: true)~> union2",
				"select3, sql union(byName: true)~> union3",
				"union1 derive(FechaHoraInicio = FechaHoraInicio+\" \"+hin,",
				"          FechaHoraFin = FechaHoraFin+\" \"+hfi) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"union3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}