{
	"name": "dw_ParadasAzure2",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_ParadasAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_ParadasAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "split1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn3 derive(VigenciaDesde = replace(VigenciaDesde,'/','-'),",
				"          VigenciaHasta = replace(VigenciaHasta,'/','-'),",
				"          CodigoPublicado = iif (\r",
				"    isNull(CodigoPublicado), ParadaHistoricaId,CodigoPublicado\r",
				"),",
				"          Latitud = replace(Latitud,',','.'),",
				"          Longitud = replace(Longitud,',','.'),",
				"          Estado = upper(Estado)) ~> derivedColumn1",
				"derivedColumn1 derive(VigenciaDesde = iif(\r",
				"    regexMatch(VigenciaDesde, '^[0-9]+$'),\r",
				"    addDays(toDate('1899-12-30'), toInteger(VigenciaDesde)),\r",
				"    iif(\r",
				"        length(split(VigenciaDesde,'-')[1]) == 4,\r",
				"        toDate(VigenciaDesde,'yyyy-MM-dd'),\r",
				"        toDate(VigenciaDesde,'dd-MM-yyyy')\r",
				"    )\r",
				"),",
				"          VigenciaHasta = iif(\r",
				"    regexMatch(VigenciaHasta, '^[0-9]+$'),\r",
				"    addDays(toDate('1899-12-30'), toInteger(VigenciaHasta)),\r",
				"    iif(\r",
				"        length(split(VigenciaHasta,'-')[1]) == 4,\r",
				"        toDate(VigenciaHasta,'yyyy-MM-dd'),\r",
				"        toDate(VigenciaHasta,'dd-MM-yyyy')\r",
				"    )\r",
				"),",
				"          AnioFuente = toInteger(AnioFuente),",
				"          Latitud = toDecimal(Latitud,9,6),",
				"          Longitud = toDecimal(Longitud,9,6),",
				"          ParadaHistoricaId = \r",
				"\r",
				"iif (\r",
				"    regexMatch(ParadaHistoricaId, '^P[0-9]{3}.*'),\r",
				"    regexExtract(ParadaHistoricaId, '(P[0-9]+)', 1),\r",
				"    ParadaHistoricaId\r",
				")) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(ParadaHistoricaId),",
				"     each(match(name!='ParadaHistoricaId'), $$ = first($$))) ~> aggregate1",
				"filter1 split(!(isNull(ParadaHistoricaId) || isNull(CodigoPublicado) || \r",
				"isNull(NombreParada) || isNull(Zona) || \r",
				"isNull(Latitud) || isNull(Longitud) || \r",
				"isNull(VigenciaDesde) || isNull(VigenciaHasta) || isNull(Estado) || !regexMatch(trim(ParadaHistoricaId), '^P[0-9]{3}$')),",
				"     disjoint: false) ~> split1@(good, bad)",
				"aggregate1 filter(Estado == 'ACTIVA') ~> filter1",
				"source1 derive(each(match(type == 'string'), $$ = trim($$))) ~> derivedColumn3",
				"split1@good sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}