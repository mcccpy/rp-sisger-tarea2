{
	"name": "dw_ParadasAzure2",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_ParadasAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_ParadasAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(VigenciaDesde = replace(trim(VigenciaDesde),'/','-'),",
				"          VigenciaHasta = replace(trim(VigenciaHasta),'/','-'),",
				"          AnioFuente = trim(AnioFuente),",
				"          ParadaHistoricaId = trim(ParadaHistoricaId),",
				"          CodigoPublicado = trim(CodigoPublicado),",
				"          NombreParada = trim(NombreParada),",
				"          Zona = trim(Zona),",
				"          Latitud = replace(trim(Latitud),',','.'),",
				"          Longitud = replace(trim(Longitud),',','.'),",
				"          Estado = trim(Estado)) ~> derivedColumn1",
				"derivedColumn1 derive(VigenciaDesde = iif(\r",
				"    length(split(VigenciaDesde,'-')[1]) == 4,\r",
				"    toDate(VigenciaDesde,'yyyy-MM-dd'),\r",
				"    toDate(VigenciaDesde,'dd-MM-yyyy')\r",
				"),",
				"          VigenciaHasta = iif(\r",
				"    length(split(VigenciaHasta,'-')[1]) == 4,\r",
				"    toDate(VigenciaHasta,'yyyy-MM-dd'),\r",
				"    toDate(VigenciaHasta,'dd-MM-yyyy')\r",
				"),",
				"          AnioFuente = toInteger(AnioFuente),",
				"          Latitud = toDecimal(Latitud,9,6),",
				"          Longitud = toDecimal(Longitud,9,6)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}