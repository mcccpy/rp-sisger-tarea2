{
	"name": "dw_RutasAzure1",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_RutasAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_RutasAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(CodigoRuta = 'R-' + right('00' + regexReplace(trim(CodigoRuta),'[^0-9]',''), 2),",
				"          VigenciaDesde = replace(trim(VigenciaDesde), '/', '-'),",
				"          VigenciaHasta = replace(trim(VigenciaHasta),'/','-'),",
				"          NombreRuta = case(\r",
				"    instr(upper(NombreRuta),'NORTE')>0, 'Ruta '+right('00' + regexReplace(CodigoRuta,'[^0-9]',''), 2)+' Norte',\r",
				"    instr(upper(NombreRuta),'SUR')>0,   'Ruta '+right('00' + regexReplace(CodigoRuta,'[^0-9]',''), 2)+' Sur',\r",
				"    instr(upper(NombreRuta),'ESTE')>0,  'Ruta '+right('00' + regexReplace(CodigoRuta,'[^0-9]',''), 2)+' Este',\r",
				"    instr(upper(NombreRuta),'OESTE')>0,   'Ruta '+right('00' + regexReplace(CodigoRuta,'[^0-9]',''), 2)+' Oeste',\r",
				"    trim(NombreRuta)\r",
				"),",
				"          AnioFuente = trim(AnioFuente),",
				"          RutaHistoricaId = trim(RutaHistoricaId),",
				"          Origen = trim(Origen),",
				"          Destino = trim(Destino),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn1 derive(RutaHistoricaId = replace(\r",
				"iif (\r",
				"    instr(RutaHistoricaId,'RH-')>0,RutaHistoricaId,\r",
				"    replace(CodigoRuta,'R-','RH-')\r",
				"),'-NEW',''),",
				"          VigenciaDesde = iif(\r",
				"    regexMatch(VigenciaDesde, '^[0-9]+$'),\r",
				"    addDays(toDate('1899-12-30'), toInteger(VigenciaDesde)),\r",
				"    iif(\r",
				"        length(split(VigenciaDesde,'-')[1]) == 4,\r",
				"        toDate(VigenciaDesde,'yyyy-MM-dd'),\r",
				"        toDate(VigenciaDesde,'dd-MM-yyyy')\r",
				"    )\r",
				"),",
				"          VigenciaHasta = iif(\r",
				"    regexMatch(VigenciaHasta, '^[0-9]+$'),\r",
				"    addDays(toDate('1899-12-30'), toInteger(VigenciaHasta)),\r",
				"    iif(\r",
				"        length(split(VigenciaHasta,'-')[1]) == 4,\r",
				"        toDate(VigenciaHasta,'yyyy-MM-dd'),\r",
				"        toDate(VigenciaHasta,'dd-MM-yyyy')\r",
				"    )\r",
				"),",
				"          AnioFuente = toInteger(AnioFuente)) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(RutaHistoricaId = derivedColumn2@RutaHistoricaId),",
				"     each(match(name!='RutaHistoricaId'), $$ = first($$))) ~> aggregate1",
				"aggregate1 filter(Estado == 'ACTIVA') ~> filter1",
				"filter1 split(!(isNull(RutaHistoricaId) || isNull(AnioFuente) \r",
				"|| isNull(CodigoRuta) || isNull(NombreRuta) \r",
				"|| isNull(Origen) || isNull(Destino) \r",
				"|| isNull(VigenciaDesde) || isNull(VigenciaHasta) || isNull(Estado)),",
				"     disjoint: false) ~> split1@(good, bad)",
				"split1@good sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}