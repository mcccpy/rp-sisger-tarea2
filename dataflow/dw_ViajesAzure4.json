{
	"name": "dw_ViajesAzure4",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_ViajesAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_ViajesAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn3 derive(FechaServicio = iif(\r",
				"    length(split(replace(FechaServicio,'/','-'),'-')[1]) == 4,\r",
				"    toDate(replace(FechaServicio,'/','-'),'yyyy-MM-dd'),\r",
				"    toDate(replace(FechaServicio,'/','-'),'dd-MM-yyyy')\r",
				"),",
				"          ViajeId = iif(\r",
				"    regexMatch(ViajeId, '^VJ-[0-9]{4}-[0-9]{5}$'),ViajeId,\r",
				"    'VJ-' + AnioFuente + '-' +regexExtract(ViajeId, '([0-9]{5})', 1)\r",
				"),",
				"          VehiculoId = 'V-' + right('000' + regexReplace(VehiculoId,'[^0-9]',''), 3),",
				"          KmRecorridos = replace(KmRecorridos,',','.'),",
				"          EstadoViaje = upper(EstadoViaje),",
				"          RutaHistoricaId = case (     regexMatch(RutaHistoricaId, '^RH-[0-9]{2}-(S|N)$'),RutaHistoricaId,     'RH-'+right('00' + regexReplace(RutaHistoricaId,'[^0-9]',''), 2) )) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = toInteger(AnioFuente),",
				"          ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
				"          KmRecorridos = toDecimal(KmRecorridos,8,1),",
				"          RutaHistoricaId = trim(RutaHistoricaId),",
				"          each(match(name == 'HoraProgramada' || name == 'HoraLlegada' || name == 'HoraSalida'), $$ = case(\r",
				"    regexMatch($$, '^[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp($$, 'dd/MM/yyyy HH:mm'),\r",
				"\r",
				"    regexMatch($$, '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp($$, 'yyyy-MM-dd HH:mm'),\r",
				"\r",
				"    regexMatch($$, '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),\r",
				"    toTimestamp($$ + ' 00:00', 'dd/MM/yyyy HH:mm'),\r",
				"\r",
				"    regexMatch($$, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toTimestamp($$ + ' 00:00', 'yyyy-MM-dd HH:mm'),\r",
				"\r",
				"    regexMatch(\r",
				"        $$,\r",
				"        '^[0-9]{4}-[0-9]{2}-[0-9]{2} 1899-12-31T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$'\r",
				"    ),\r",
				"    toTimestamp(\r",
				"        substring($$,1,10)\r",
				"        + ' ' +\r",
				"        substring($$,22,8),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    regexMatch(\r",
				"        $$,\r",
				"        '^1899-12-31T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$'\r",
				"    ),\r",
				"    toTimestamp(\r",
				"        '9999-12-31 ' + substring($$,12,8),\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    ),\r",
				"\r",
				"    toTimestamp(\r",
				"        '9999-12-31 00:00:00',\r",
				"        'yyyy-MM-dd HH:mm:ss'\r",
				"    )\r",
				"))) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(ViajeId,",
				"          AnioFuente),",
				"     each(match(name != 'ViajeId' && name != 'AnioFuente'), $$ = last($$))) ~> aggregate1",
				"source1 filter(!(isNull(RutaHistoricaId) && isNull(VehiculoId))) ~> filter1",
				"filter1 derive(each(match(type=='string'), $$ = trim($$))) ~> derivedColumn3",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}