{
	"name": "dw_ViajesAzure4",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_ViajesAzure",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_ViajesAzure",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(FechaServicio = iif(\r",
				"    length(split(replace(trim(FechaServicio),'/','-'),'-')[1]) == 4,\r",
				"    toDate(replace(trim(FechaServicio),'/','-'),'yyyy-MM-dd'),\r",
				"    toDate(replace(trim(FechaServicio),'/','-'),'dd-MM-yyyy')\r",
				"),",
				"          AnioFuente = trim(AnioFuente),",
				"          ViajeId = iif(\r",
				"    regexMatch(trim(ViajeId), '^VJ-[0-9]{4}-[0-9]{5}$'),trim(ViajeId),\r",
				"    'VJ-' + AnioFuente + '-' +regexExtract(trim(ViajeId), '([0-9]{5})', 1)\r",
				")\r",
				"\r",
				",",
				"          RutaHistoricaId = \r",
				"case (\r",
				"    regexMatch(trim(RutaHistoricaId), '^RH-[0-9]{2}-(S|N)$'),trim(RutaHistoricaId),\r",
				"    regexMatch(trim(RutaHistoricaId), '^RH-[0-9]{2}$'),trim(RutaHistoricaId),\r",
				"    'RH-'+regexExtract(trim(RutaHistoricaId), '([0-9]{2})', 1)\r",
				"),",
				"          VehiculoId = iif(\r",
				"    regexMatch(trim(VehiculoId), '^V-[0-9]{3}$'),trim(VehiculoId),\r",
				"    'V-' +regexExtract(trim(VehiculoId), '([0-9]{3})', 1)\r",
				"),",
				"          HoraProgramada = trim(HoraProgramada),",
				"          HoraSalida = trim(HoraSalida),",
				"          HoraLlegada = trim(HoraLlegada),",
				"          ValidacionesTarjeta = trim(ValidacionesTarjeta),",
				"          KmRecorridos = trim(KmRecorridos),",
				"          EstadoViaje = upper(trim(EstadoViaje))) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = toInteger(AnioFuente),",
				"          HoraProgramada = case(\r",
				"    regexMatch(HoraProgramada, '^[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(HoraProgramada, 'dd/MM/yyyy HH:mm:ss'),\r",
				"\r",
				"    regexMatch(HoraProgramada, '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(HoraProgramada, 'yyyy-MM-dd HH:mm:ss'),\r",
				"\r",
				"    regexMatch(HoraProgramada, '^[0-9]{2}:[0-9]{2}$'), \r",
				"    toTimestamp(toString(FechaServicio)+' '+HoraProgramada+':00', 'yyyy-MM-dd HH:mm:ss'),\r",
				"    toTimestamp(HoraProgramada)\r",
				"    \r",
				")\r",
				",",
				"          HoraSalida = case(\r",
				"    regexMatch(HoraSalida, '^[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(HoraSalida, 'dd/MM/yyyy HH:mm:ss'),\r",
				"\r",
				"    regexMatch(HoraSalida, '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(HoraSalida, 'yyyy-MM-dd HH:mm:ss'),\r",
				"\r",
				"    regexMatch(HoraSalida, '^[0-9]{2}:[0-9]{2}$'), \r",
				"    toTimestamp(toString(FechaServicio)+' '+HoraSalida+':00', 'yyyy-MM-dd HH:mm:ss'),\r",
				"    toTimestamp(HoraSalida)\r",
				"    \r",
				"),",
				"          HoraLlegada = case(\r",
				"    regexMatch(HoraLlegada, '^[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(HoraLlegada, 'dd/MM/yyyy HH:mm:ss'),\r",
				"\r",
				"    regexMatch(HoraLlegada, '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'),\r",
				"    toTimestamp(HoraLlegada, 'yyyy-MM-dd HH:mm:ss'),\r",
				"\r",
				"    regexMatch(HoraLlegada, '^[0-9]{2}:[0-9]{2}$'), \r",
				"    toTimestamp(toString(FechaServicio)+' '+HoraLlegada+':00', 'yyyy-MM-dd HH:mm:ss'),\r",
				"    toTimestamp(HoraLlegada)\r",
				"    \r",
				"),",
				"          ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
				"          KmRecorridos = toDecimal(KmRecorridos,8,1)) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(ViajeId),",
				"     each(match(name!='ViajeId'), $$ = first($$))) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}